# Copy to .env (git-ignored). Use a FRESH low-balance key, never your main wallet.
PRIVATE_KEY=0x...
ESCROW_ADDRESS=0x...
# Testnet only: the MockWIF address printed by Deploy.s.sol
TOKEN_ADDRESS=0x...
PER_CLAIM=10
MAX_CLAIMS=1
# Optional: claim to a specific address instead of a random fresh one
# RECIPIENT=0x...
# Optional: Alchemy URL instead of the rate-limited public RPC
# RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/KEY
# Mainnet only:
# CONFIRM_MAINNET=yes
