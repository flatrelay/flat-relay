# Copy to .env.local (git-ignored). Never commit real values.

# Optional: Alchemy URL instead of the rate-limited public RPC (recommended before launch)
# NEXT_PUBLIC_RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/KEY

# Gas-free claims. A NEW throwaway key that only ever holds a little ETH for gas.
# Never the deployer, never a wallet holding $WIF. No NEXT_PUBLIC_ prefix: server-only.
RELAYER_PRIVATE_KEY=
# Only sponsor gifts paying at least this many $WIF per claim (stops dust-gift gas draining)
RELAYER_MIN_REWARD_WIF=1
# Stop sponsoring when the relayer's ETH drops below this
RELAYER_MIN_BALANCE_ETH=0.0002
# Max sponsored claims per day (shared across instances when Upstash is set)
RELAYER_DAILY_CAP=300

# Optional but recommended in production: shared rate limits + send lock across Vercel instances.
# Upstash Redis REST credentials (the Vercel Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN,
# which also work). Without these, limits fall back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: WalletConnect (phone wallets via QR). Free project ID from https://dashboard.reown.com
# (allowlist flat-relay.vercel.app and localhost). Public by design. Without it, only browser wallets are offered.
NEXT_PUBLIC_WC_PROJECT_ID=
