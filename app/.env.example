# Copy to .env.local (git-ignored). Never commit real values.

# Optional: Alchemy URL instead of the rate-limited public RPC (recommended before launch)
# NEXT_PUBLIC_RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/KEY

# Gas-free claims. A NEW throwaway key that only ever holds a little ETH for gas.
# Never the deployer, never a wallet holding $WIF. No NEXT_PUBLIC_ prefix: server-only.
RELAYER_PRIVATE_KEY=
# Only sponsor gifts paying at least this many $WIF per claim (stops dust-gift gas draining)
RELAYER_MIN_REWARD_WIF=1
# Stop sponsoring when the relayer's ETH drops below this
RELAYER_MIN_BALANCE_ETH=0.0002
# Max sponsored claims per day per server instance
RELAYER_DAILY_CAP=300
